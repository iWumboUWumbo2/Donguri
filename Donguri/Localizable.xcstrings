      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtered"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あぼーん"
          }
        }
      }
    },
