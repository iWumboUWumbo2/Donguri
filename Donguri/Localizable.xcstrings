      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No NG filters"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "NG設定はありません"
          }
        }
      }
    },
    "No data received from Anki. Please try again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Ankiからデータを受信できませんでした。もう一度お試しください。"
          }
        }
      }
    },
