{
  "sourceLanguage": "en",
  "strings": {
    "%lld": {
      "comment": "Post number badge.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld"
          }
        }
      }
    },
    ">>%lld にジャンプ": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Jump to >>%lld"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": ">>%lld にジャンプ"
          }
        }
      }
    },
    "Anki": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Anki"
          }
        }
      }
    },
    "App directory not found": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリのディレクトリが見つかりません"
          }
        }
      }
    },
    "Arranges glossaries in two columns. Only recommended when used with full-width or on larger screens.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "語義を2列に並べます。全幅表示または大きな画面での使用のみ推奨します。"
          }
        }
      }
    },
    "Could not access file": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルにアクセスできませんでした"
          }
        }
      }
    },
    "Failed to decode Anki response:\n\n%@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Ankiの応答を解析できませんでした:\n\n%@"
          }
        }
      }
    },
