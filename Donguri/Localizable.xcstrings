      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無効なURLが指定されました"
          }
        }
      }
    },
    "NG ID": {
      "comment": "Kind of NG rule, shown in a segmented picker and as a section header.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ID"
