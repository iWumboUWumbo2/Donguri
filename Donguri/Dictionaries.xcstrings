    "Import Anki Backup (Stored Words: %@)": {
      "comment": "Context: Settings > Anki. Surrounding UI configures Anki deck/model selection, backup import, duplicate handling, field mappings, tags, and fetch confirmation alerts.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Ankiのバックアップを読み込む（登録語数: %@）"
          }
        }
      }
    },
    "Importing a .colpkg/.apkg backup from Anki will allow Donguri to check for duplicates immediately. It's recommended to do this periodically to reduce drift.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Ankiの.colpkg/.apkgバックアップを読み込むと、Donguriがすぐに重複を判定できるようになります。ずれを防ぐため、定期的に行うことをおすすめします。"
          }
        }
      }
    },
